# Copy to .env and adjust. Read only by server/src/config.js (and the seed script).

NODE_ENV=development
PORT=3000
# `npm run db` starts a local MongoDB on this address if you don't have one.
MONGODB_URI=mongodb://127.0.0.1:27017/sports-iq
# At least 32 random characters. Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters
# Relative to the server folder.
UPLOAD_DIR=uploads
LOG_LEVEL=info

# Seed accounts — development data only, never reuse in production.
# Coaches get emails like firstname.lastname@turi.test and share SEED_COACH_PASSWORD.
SEED_ADMIN_EMAIL=director.sport@turi.test
SEED_ADMIN_PASSWORD=TuriAdmin-2026-dev
SEED_COACH_PASSWORD=TuriCoach-2026-dev
