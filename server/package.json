{
  "name": "@sports-iq/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "db": "node --env-file-if-exists=../.env scripts/dev-db.js",
    "seed": "node --env-file-if-exists=../.env scripts/seed.js",
    "test": "vitest run"
  },
  "dependencies": {
    "cookie-parser": "1.4.7",
    "express": "5.3.0",
    "express-openapi-validator": "5.6.2",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.2",
    "pino": "10.4.0",
    "pino-http": "11.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1",
    "vitest": "5.0.4"
  }
}
